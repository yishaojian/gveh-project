---
// src/pages/zh/blog/[...slug].astro
// ==========================================
// CHINESE BLOG ARTICLE PAGE（Markdown 渲染 + 完整 SEO）
// ==========================================
import { getAllPosts, getPostBySlug, categoryName } from '../../../utils/blog';
import { render } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getAllPosts('zh');
  return posts.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const post = await getPostBySlug(slug ?? '', 'zh');

if (!post) {
  return Astro.redirect('/zh/blog');
}

const { Content } = await render(post.entry);

const allPosts = await getAllPosts('zh');
const idx = allPosts.findIndex((p) => p.slug === post.slug);
const prev = idx > 0 ? allPosts[idx - 1] : null;
const next = idx < allPosts.length - 1 ? allPosts[idx + 1] : null;

const canonical = `https://www.pnds.com.cn/zh/blog/${post.slug}`;
// 只有存在对应语言的文章时才互相链接；否则语言切换指向英文博客索引（避免 404）
const otherPost = await getPostBySlug(post.slug, 'en');
const enUrl = otherPost
  ? `https://www.pnds.com.cn/blog/${post.slug}`
  : 'https://www.pnds.com.cn/blog';
const publishedDate = post.date.toISOString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: post.title,
  description: post.description,
  datePublished: publishedDate,
  dateModified: publishedDate,
  author: { '@type': 'Organization', name: post.author },
  publisher: {
    '@type': 'Organization',
    name: 'PNDS',
    logo: { '@type': 'ImageObject', url: 'https://www.pnds.com.cn/pnds-logo.png' },
  },
  keywords: post.keywords.join(', '),
  inLanguage: 'zh-CN',
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
};
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{post.title} | PNDS</title>
    <meta name="description" content={post.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={canonical} />
    {otherPost && <link rel="alternate" hreflang="en" href={enUrl} />}
    <link rel="alternate" hreflang="x-default" href={otherPost ? enUrl : canonical} />

    <meta property="og:type" content="article" />
    <meta property="og:title" content={post.title} />
    <meta property="og:description" content={post.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="PNDS" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="article:published_time" content={publishedDate} />
    <meta property="article:section" content={post.category} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={post.title} />
    <meta name="twitter:description" content={post.description} />

    <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Inter:wght@400;700&display=swap" rel="stylesheet" />

    <style is:inline>
      body {
        margin: 0;
        padding: 0;
        background-color: #09090b !important;
        color: #fafafa !important;
        font-family: 'Inter', sans-serif;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      .gveh-header { padding: 25px 5%; display: flex !important; justify-content: space-between !important; align-items: flex-start !important; }
      .gveh-logo-link { text-decoration: none !important; display: block !important; width: 180px !important; position: absolute !important; top: 25px !important; left: 5% !important; z-index: 999 !important; }
      .gveh-lang-top-btn {
        text-decoration: none !important; font-family: 'Space Mono', monospace !important; font-size: 12px !important;
        font-weight: 700 !important; color: #aaa !important; border: 1px solid #333 !important; padding: 6px 12px !important;
        border-radius: 4px !important; background: transparent !important; transition: all 0.3s ease !important;
      }
      .gveh-lang-top-btn:hover { color: #f39c12 !important; border-color: #f39c12 !important; }
      .gveh-top-right-container { position: absolute !important; top: 25px !important; right: 5% !important; z-index: 999 !important; display: flex !important; align-items: center !important; gap: 12px !important; }
      .gveh-auth-btn {
        text-decoration: none !important; font-family: 'Space Mono', monospace !important; font-size: 12px !important; font-weight: 700 !important;
        color: #aaa !important; border: 1px solid #333 !important; padding: 6px 12px !important; border-radius: 4px !important;
        background: transparent !important; transition: all 0.3s ease !important; cursor: pointer !important;
      }
      .gveh-auth-btn:hover { color: #f39c12 !important; border-color: #f39c12 !important; }

      .gveh-content { flex: 1; max-width: 780px; margin: 120px auto 80px auto; padding: 0 40px; width: 100%; box-sizing: border-box; }
      .gveh-back-link { display: inline-flex; align-items: center; gap: 8px; color: #aaa; text-decoration: none; font-family: 'Space Mono', monospace; font-size: 12px; margin-bottom: 24px; transition: color 0.3s ease; }
      .gveh-back-link:hover { color: #f39c12; }

      .gveh-blog-header { margin-bottom: 40px; border-bottom: 1px solid #333; padding-bottom: 28px; }
      .gveh-blog-title { font-size: 2.3rem; font-weight: 700; line-height: 1.25; margin: 0 0 16px 0; color: #fafafa; }
      .gveh-blog-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; color: #888; font-size: 13px; font-family: 'Space Mono', monospace; }
      .gveh-blog-category { padding: 2px 8px; background-color: rgba(139, 92, 246, 0.15); border: 1px solid rgba(139, 92, 246, 0.3); border-radius: 4px; color: #a78bfa; }

      .gveh-blog-content { font-size: 17px; line-height: 1.85; color: #e5e5e5; }
      .gveh-blog-content h1, .gveh-blog-content h2, .gveh-blog-content h3, .gveh-blog-content h4 { color: #fafafa; line-height: 1.3; }
      .gveh-blog-content h1 { font-size: 1.9rem; margin: 36px 0 16px; }
      .gveh-blog-content h2 { font-size: 1.5rem; margin: 36px 0 14px; }
      .gveh-blog-content h3 { font-size: 1.2rem; margin: 28px 0 12px; }
      .gveh-blog-content p { margin: 0 0 20px 0; }
      .gveh-blog-content ul, .gveh-blog-content ol { margin: 0 0 20px 0; padding-left: 24px; }
      .gveh-blog-content li { margin-bottom: 8px; }
      .gveh-blog-content a { color: #f39c12; }
      .gveh-blog-content strong { color: #fafafa; }
      .gveh-blog-content code { background: rgba(243, 156, 18, 0.1); padding: 2px 6px; border-radius: 4px; font-family: 'Space Mono', monospace; font-size: 14px; color: #f39c12; }
      .gveh-blog-content pre { background: #1a1a1e; padding: 20px; border-radius: 8px; overflow-x: auto; margin: 24px 0; }
      .gveh-blog-content pre code { background: none; padding: 0; color: #e5e5e5; }

      .gveh-keywords { margin-top: 40px; padding-top: 28px; border-top: 1px solid #333; }
      .gveh-keywords-label { font-family: 'Space Mono', monospace; font-size: 12px; color: #888; margin-bottom: 12px; text-transform: uppercase; letter-spacing: 1px; }
      .gveh-keywords-list { display: flex; flex-wrap: wrap; gap: 8px; }
      .gveh-keyword-tag { background: rgba(243, 156, 18, 0.1); color: #f39c12; padding: 5px 12px; border-radius: 4px; font-family: 'Space Mono', monospace; font-size: 12px; }

      .gveh-post-nav { margin-top: 48px; padding-top: 28px; border-top: 1px solid #333; display: flex; justify-content: space-between; gap: 20px; }
      .gveh-post-nav-link { flex: 1; text-decoration: none; color: #a1a1aa; border: 1px solid #27272a; padding: 16px; border-radius: 8px; transition: all 0.3s ease; }
      .gveh-post-nav-link:hover { border-color: rgba(245, 158, 11, 0.4); color: #fafafa; }
      .gveh-post-nav-label { font-family: 'Space Mono', monospace; font-size: 11px; color: #71717a; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 6px; }
      .gveh-post-nav-title { font-size: 14px; line-height: 1.4; }
      .gveh-post-nav-link.next { text-align: right; }

      @media (max-width: 768px) {
        .gveh-logo-link { width: 130px !important; position: static !important; margin: 0 auto 20px auto !important; display: block !important; top: auto !important; left: auto !important; }
        .gveh-top-right-container { position: static !important; top: auto !important; right: auto !important; margin-bottom: 20px !important; flex-wrap: wrap !important; justify-content: center !important; }
        .gveh-header { flex-direction: column !important; align-items: center !important; padding: 20px 5% !important; }
        .gveh-content { margin: 60px auto 60px auto; padding: 0 20px; }
        .gveh-blog-title { font-size: 1.8rem; }
        .gveh-blog-content { font-size: 16px; }
        .gveh-post-nav { flex-direction: column; }
      }
    </style>
  </head>
  <body>
    <header class="gveh-header">
      <a href="/zh" class="gveh-logo-link">
        <img src="/pnds-logo.png" alt="PNDS 胖达硬件严选" style="width: 100% !important; height: auto !important;" />
      </a>
      <div class="gveh-top-right-container">
        <a href={otherPost ? `/blog/${post.slug}` : '/blog'} class="gveh-lang-top-btn" title={otherPost ? 'Read this article in English' : 'English blog'}>中文 / EN</a>
        <div id="gveh-auth-container">
          <a href="/login" class="gveh-auth-btn">登录</a>
        </div>
      </div>
    </header>

    <main class="gveh-content">
      <a href="/zh/blog" class="gveh-back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        返回博客
      </a>

      <article>
        <header class="gveh-blog-header">
          <h1 class="gveh-blog-title">{post.title}</h1>
          <div class="gveh-blog-meta">
            <span class="gveh-blog-category">{categoryName(post.category, 'zh')}</span>
            <span>作者：{post.author}</span>
            <span>•</span>
            <span>{post.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          </div>
        </header>

        <div class="gveh-blog-content">
          <Content />
        </div>

        {post.keywords.length > 0 && (
          <div class="gveh-keywords">
            <div class="gveh-keywords-label">关键词</div>
            <div class="gveh-keywords-list">
              {post.keywords.map((k) => <span class="gveh-keyword-tag">{k}</span>)}
            </div>
          </div>
        )}

        <nav class="gveh-post-nav">
          {prev ? (
            <a href={`/zh/blog/${prev.slug}`} class="gveh-post-nav-link">
              <div class="gveh-post-nav-label">← 上一篇</div>
              <div class="gveh-post-nav-title">{prev.title}</div>
            </a>
          ) : <span></span>}
          {next ? (
            <a href={`/zh/blog/${next.slug}`} class="gveh-post-nav-link next">
              <div class="gveh-post-nav-label">下一篇 →</div>
              <div class="gveh-post-nav-title">{next.title}</div>
            </a>
          ) : <span></span>}
        </nav>
      </article>
    </main>

    <script>
      function updateAuthStatus() {
        const authContainer = document.getElementById('gveh-auth-container');
        const userData = localStorage.getItem('currentUser');
        if (userData) {
          try {
            const user = JSON.parse(userData);
            const roleText = user.role === 'admin' ? '管理员' : (user.role === 'sales' ? '业务员' : '客户');
            const initial = (user.name || '用').charAt(0).toUpperCase();
            authContainer.innerHTML = '<a href="/dashboard/' + user.role + '" style="text-decoration:none;font-family:\'Space Mono\',monospace;font-size:12px;font-weight:700;color:#f39c12;">' + initial + ' · ' + roleText + '</a>';
          } catch (e) { console.error('Failed to parse user data', e); }
        }
      }
      document.addEventListener('DOMContentLoaded', updateAuthStatus);
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </body>
</html>
