// src/pages/zh/index.astro
// ==========================================
// VETERAN.CORE // CHINESE HOMEPAGE
// ==========================================
// 型号数据（构建时读 parts.json，渐进式随批次增长）
import fs from 'node:fs';
import path from 'node:path';
import { getAllPosts, categoryName } from '../../utils/blog';

let featuredParts = [];
let partsMeta = { count: 0, total: 0, updatedAt: '' };
try {
  const parts = JSON.parse(
    fs.readFileSync(path.join(process.cwd(), 'src/data/parts.json'), 'utf8')
  );
  const FEATURED = 6;
  if (parts.length <= FEATURED) {
    featuredParts = parts;
  } else {
    const day = new Date();
    const seed = day.getUTCFullYear() * 10000 + (day.getUTCMonth() + 1) * 100 + day.getUTCDate();
    const start = (seed * FEATURED) % parts.length;
    featuredParts = parts.slice(start, start + FEATURED);
    if (featuredParts.length < FEATURED) {
      featuredParts = featuredParts.concat(parts.slice(0, FEATURED - featuredParts.length));
    }
  }
} catch (e) {
  featuredParts = [];
}
try {
  partsMeta = JSON.parse(
    fs.readFileSync(path.join(process.cwd(), 'src/data/parts-meta.json'), 'utf8')
  );
} catch (e) {
  partsMeta = { count: featuredParts.length, total: 0, updatedAt: '' };
}

// 最新中文文章（服务端渲染，避免客户端占位“加载文章中...”）
const latestPosts = (await getAllPosts('zh')).slice(0, 3);
