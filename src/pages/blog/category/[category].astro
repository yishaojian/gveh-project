---
// src/pages/blog/category/[category].astro
// ==========================================
// ENGLISH BLOG CATEGORY PAGE（Markdown 内容集合，构建期静态化）
// ==========================================
import { getAllPosts, getCategories, CATEGORY_META } from '../../../utils/blog';

export const prerender = true;

export async function getStaticPaths() {
  // 预定义分类（首页卡片会直接链接）+ 已有文章的分类，取并集，避免空分类页 404
  const fromPosts = await getCategories('en');
  const categories = Array.from(new Set([...Object.keys(CATEGORY_META), ...fromPosts]));
  return categories.map((c) => ({ params: { category: c } }));
}

const { category } = Astro.params;
const posts = (await getAllPosts('en')).filter((p) => p.category === category);
const meta = CATEGORY_META[category ?? ''];

const title = meta ? meta.en : (category ?? 'Category');
const description = meta ? meta.zh : '';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | PNDS</title>
    <meta name="description" content={`${title} — technical analysis and notes from PNDS.`} />
    <link rel="canonical" href={`https://www.pnds.com.cn/blog/category/${category}`} />
    <link rel="alternate" hreflang="en" href={`https://www.pnds.com.cn/blog/category/${category}`} />
    <link rel="alternate" hreflang="zh-CN" href={`https://www.pnds.com.cn/zh/blog/category/${category}`} />
<style is:inline>
      body {
        margin: 0;
        padding: 0;
        background-color: #09090b !important;
        color: #fafafa !important;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', Roboto, 'Helvetica Neue', Arial, sans-serif;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      .gveh-header { padding: 25px 5%; display: flex !important; justify-content: space-between !important; align-items: flex-start !important; }
      .gveh-logo-link { text-decoration: none !important; display: block !important; width: 180px !important; position: absolute !important; top: 25px !important; left: 5% !important; z-index: 999 !important; }
      .gveh-lang-top-btn {
        text-decoration: none !important; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace !important; font-size: 12px !important;
        font-weight: 700 !important; color: #aaa !important; border: 1px solid #333 !important; padding: 6px 12px !important;
        border-radius: 4px !important; background: transparent !important; transition: all 0.3s ease !important;
      }
      .gveh-lang-top-btn:hover { color: #f39c12 !important; border-color: #f39c12 !important; }
      .gveh-top-right-container { position: absolute !important; top: 25px !important; right: 5% !important; z-index: 999 !important; display: flex !important; align-items: center !important; gap: 12px !important; }
      .gveh-auth-btn {
        text-decoration: none !important; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace !important; font-size: 12px !important; font-weight: 700 !important;
        color: #aaa !important; border: 1px solid #333 !important; padding: 6px 12px !important; border-radius: 4px !important;
        background: transparent !important; transition: all 0.3s ease !important; cursor: pointer !important;
      }
      .gveh-auth-btn:hover { color: #f39c12 !important; border-color: #f39c12 !important; }

      .gveh-content { flex: 1; max-width: 900px; margin: 140px auto 180px auto; padding: 0 40px; width: 100%; box-sizing: border-box; }
      .gveh-page-title { font-size: 2.2rem; font-weight: 700; color: #fff; margin: 0 0 8px 0; }
      .gveh-page-desc { color: #a1a1aa; font-size: 1rem; margin: 0 0 40px 0; }

      .gveh-blog-list { display: flex; flex-direction: column; gap: 24px; }
      .gveh-blog-card {
        display: block; text-decoration: none !important; background-color: #141417 !important;
        border: 1px solid rgba(63, 63, 70, 0.4) !important; padding: 24px; border-radius: 8px; transition: all 0.3s ease;
      }
      .gveh-blog-card:hover { border-color: rgba(245, 158, 11, 0.4) !important; transform: translateX(4px); }
      .gveh-blog-meta { display: flex; gap: 16px; align-items: center; font-size: 0.78rem; color: #71717a; margin-bottom: 12px; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace; }
      .gveh-blog-category { padding: 2px 8px; background-color: rgba(139, 92, 246, 0.15); border: 1px solid rgba(139, 92, 246, 0.3); border-radius: 4px; color: #a78bfa; }
      .gveh-blog-title { font-size: 1.25rem; font-weight: 600; color: #fff; margin: 0 0 10px 0; line-height: 1.4; }
      .gveh-blog-excerpt { font-size: 0.95rem; color: #a1a1aa; line-height: 1.6; margin: 0; }

      .gveh-empty-state { text-align: center; padding: 80px 20px; }
      .gveh-empty-icon { font-size: 3rem; margin-bottom: 16px; opacity: 0.5; }
      .gveh-empty-title { font-size: 1.25rem; font-weight: 600; color: #fff; margin: 0 0 8px 0; }
      .gveh-empty-desc { font-size: 0.95rem; color: #71717a; margin: 0; }

      @media (max-width: 768px) {
        .gveh-logo-link { width: 130px !important; position: static !important; margin: 0 auto 20px auto !important; display: block !important; top: auto !important; left: auto !important; }
        .gveh-top-right-container { position: static !important; top: auto !important; right: auto !important; margin-bottom: 20px !important; flex-wrap: wrap !important; justify-content: center !important; }
        .gveh-header { flex-direction: column !important; align-items: center !important; padding: 20px 5% !important; }
        .gveh-content { margin: 60px auto 140px auto; padding: 0 20px; }
        .gveh-page-title { font-size: 1.8rem; }
      }
    </style>
  </head>
  <body>
    <header class="gveh-header">
      <a href="/" class="gveh-logo-link">
        <img src="/pnds-logo.png" alt="PNDS Panda Hardware Expertise" style="width: 100% !important; height: auto !important;" />
      </a>
      <div class="gveh-top-right-container">
        <a href={`/zh/blog/category/${category}`} class="gveh-lang-top-btn">EN / 中文</a>
        <div id="gveh-auth-container">
          <a href="/login" class="gveh-auth-btn">LOGIN</a>
        </div>
      </div>
    </header>

    <main class="gveh-content">
      <h1 class="gveh-page-title">{meta ? meta.icon + ' ' + title : title}</h1>
      <p class="gveh-page-desc">{description}</p>

      {posts.length > 0 ? (
        <div class="gveh-blog-list">
          {posts.map((p) => (
            <a href={`/blog/${p.slug}`} class="gveh-blog-card">
              <div class="gveh-blog-meta">
                <span class="gveh-blog-category">{title}</span>
                <span>{p.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
              </div>
              <h2 class="gveh-blog-title">{p.title}</h2>
              <p class="gveh-blog-excerpt">{p.description}</p>
            </a>
          ))}
        </div>
      ) : (
        <div class="gveh-empty-state">
          <div class="gveh-empty-icon">📭</div>
          <h3 class="gveh-empty-title">No Articles Yet</h3>
          <p class="gveh-empty-desc">No articles have been published in this category yet.</p>
        </div>
      )}
    </main>

    <script>
      function updateAuthStatus() {
        const authContainer = document.getElementById('gveh-auth-container');
        const userData = localStorage.getItem('currentUser');
        if (userData) {
          try {
            const user = JSON.parse(userData);
            const roleText = user.role === 'admin' ? 'Admin' : (user.role === 'sales' ? 'Sales' : 'Customer');
            const initial = (user.name || 'U').charAt(0).toUpperCase();
            authContainer.innerHTML = '<a href="/dashboard/' + user.role + '" style="text-decoration:none;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;font-weight:700;color:#f39c12;">' + initial + ' · ' + roleText + '</a>';
          } catch (e) { console.error('Failed to parse user data', e); }
        }
      }
      document.addEventListener('DOMContentLoaded', updateAuthStatus);
    </script>
  </body>
</html>
